{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Common settings: Ninja generator, build and install dirs named after the preset",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/build/${presetName}/pikaball-release"
    },
    {
      "name": "not-windows",
      "hidden": true,
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "debug",
      "inherits": ["base", "not-windows"],
      "displayName": "Debug Config",
      "description": "Debug build using Ninja generator",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PIKA_EMBED_ASSETS": "OFF"
      }
    },
    {
      "name": "release",
      "inherits": ["base", "not-windows"],
      "displayName": "Release Config",
      "description": "Release build using Ninja generator",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PIKA_EMBED_ASSETS": "OFF"
      }
    },
    {
      "name": "release-embedded",
      "inherits": ["base", "not-windows"],
      "displayName": "Release Embedded Config",
      "description": "Release build with assets embedded in the executable",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PIKA_EMBED_ASSETS": "ON"
      }
    },
    {
      "name": "windows-release",
      "inherits": ["base", "windows"],
      "displayName": "Windows Release Config",
      "description": "Windows release build (MinGW)",
      "binaryDir": "${sourceDir}/build/release-win",
      "installDir": "${sourceDir}/build/release-win/pikaball-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PIKA_EMBED_ASSETS": "OFF"
      }
    },
    {
      "name": "windows-release-embedded",
      "inherits": ["base", "windows"],
      "displayName": "Windows Release Embedded Config",
      "description": "Windows release build (MinGW) with assets embedded in the executable",
      "binaryDir": "${sourceDir}/build/release-win-embedded",
      "installDir": "${sourceDir}/build/release-win-embedded/pikaball-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PIKA_EMBED_ASSETS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "displayName": "Debug Build",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "configurePreset": "release"
    },
    {
      "name": "release-embedded",
      "displayName": "Release Embedded Build",
      "configurePreset": "release-embedded"
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release Build",
      "configurePreset": "windows-release"
    },
    {
      "name": "windows-release-embedded",
      "displayName": "Windows Release Embedded Build",
      "configurePreset": "windows-release-embedded"
    }
  ]
}
